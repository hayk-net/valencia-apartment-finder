{
  "name": "valencia-apartment-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal aggregator of Valencia apartment listings from portals and developer sites",
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\" && npm --prefix web run build",
    "start": "node dist/server/index.js",
    "refresh": "tsx src/ingest/cli.ts",
    "seed": "tsx src/ingest/seed.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
