# Copy to .env — the server loads it automatically.

# Claude API key for the AI analyst (gem scoring): https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional overrides
# REALTOR_AI_MODEL=claude-opus-5        # e.g. claude-haiku-4-5 for ~5x cheaper runs
# REALTOR_AI_EFFORT=medium              # low | medium | high

# Idealista official API (arrives by email after applying)
IDEALISTA_API_KEY=
IDEALISTA_SECRET=
